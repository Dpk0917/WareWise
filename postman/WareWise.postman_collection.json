        },
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  const candidates = [",
                  "    body.id,",
                  "    body.userId,",
                  "    body.data?.id,",
                  "    body.data?.userId,",
                  "  ];",
                  "  const generatedId = candidates.find(value => value !== undefined && value !== null && String(value).trim() !== '');",
                  "  if (generatedId !== undefined) {",
                  "    pm.collectionVariables.set('userId', String(generatedId));",
                  "    console.log('Saved userId:', String(generatedId));",
                  "  } else {",
                  "    console.error('Could not find an ID in the response for userId. Response:', body);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Morgan\",\n  \"role\": \"Warehouse Manager\",\n  \"email\": \"alex.{{$guid}}@example.com\",\n  \"contact\": \"9876543210\"\n}",
