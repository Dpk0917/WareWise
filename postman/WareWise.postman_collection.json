{
  "info": {
    "_postman_id": "c0bfe6c8-7d82-4c9f-b2de-9d3b39d18839",
    "name": "WareWise API",
    "description": "CRUD and filter requests for users, purchase orders, and waste records. To create a purchase order with an empty database, run these requests in order: Users > Create user; Purchase Orders > Setup: Create category; Purchase Orders > Setup: Create supplier; Purchase Orders > Setup: Create product; then Purchase Orders > Create purchase order. The setup requests save IDs returned by the API to collection variables. ID fields are sent as strings so numeric IDs and UUIDs can be represented; the backend must still resolve IDs that actually exist. The default baseUrl assumes the app is running locally on port 8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
